#!/usr/bin/env bash
set -euo pipefail

# SiYuan - Tester Environment CLI
# Usage: ./tester-env <command> [--run-id <id>] [--port <port>]
# Commands: deploy, seed, verify, reset, stop, logs, status, help

RUN_ID="default"
PORT="6806"
AUTH_CODE="siyuan123"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TESTER_ENV_PROJECT="${TESTER_ENV_PROJECT:-tester-env}"
TESTER_ENV_APP="${TESTER_ENV_APP:-siyuan}"
TESTER_ENV_SCENARIO="${TESTER_ENV_SCENARIO:-manual}"

refresh_names() {
    local suffix=""
    if [[ "${RUN_ID}" != "default" ]]; then
        suffix="-${RUN_ID}"
    fi

    CONTAINER_NAME="tester-env-siyuan${suffix}"
    # IMAGE_TAG set by scripts/rl-env to a content-addressed tag so identical
    # (baseline, patch-set) combos share an image. Manual invocations get :dev.
    IMAGE_NAME="${IMAGE_TAG:-tester-env-siyuan:dev}"
    DATA_VOLUME="siyuan-workspace${suffix}"
}

cmd_deploy() {
    echo "==> Building Docker image from source..."
    docker build \
        --label "tester-env.project=${TESTER_ENV_PROJECT}" \
        --label "tester-env.app=${TESTER_ENV_APP}" \
        --label "tester-env.scenario=${TESTER_ENV_SCENARIO}" \
        -t "${IMAGE_NAME}" \
        "${SCRIPT_DIR}"

    echo "==> Starting container on port ${PORT}..."
    docker volume create \
        --label "tester-env.project=${TESTER_ENV_PROJECT}" \
        --label "tester-env.app=${TESTER_ENV_APP}" \
        --label "tester-env.scenario=${TESTER_ENV_SCENARIO}" \
        --label "tester-env.run_id=${TESTER_ENV_RUN_ID:-${RUN_ID}}" \
        "${DATA_VOLUME}" >/dev/null
    docker run -d --name "${CONTAINER_NAME}" \
        --label "tester-env.project=${TESTER_ENV_PROJECT}" \
        --label "tester-env.app=${TESTER_ENV_APP}" \
        --label "tester-env.scenario=${TESTER_ENV_SCENARIO}" \
        --label "tester-env.run_id=${TESTER_ENV_RUN_ID:-${RUN_ID}}" \
        -p "${PORT}:6806" \
        -v "${DATA_VOLUME}:/siyuan/workspace" \
        -e SIYUAN_ACCESS_AUTH_CODE_BYPASS=true \
        "${IMAGE_NAME}"

    echo "==> Waiting for app to start..."
    for i in $(seq 1 30); do
        if curl -sf http://localhost:"${PORT}"/api/system/version > /dev/null 2>&1; then
            echo "==> Deployment complete. App running at http://localhost:${PORT}"
            echo "==> Auth bypassed (SIYUAN_ACCESS_AUTH_CODE_BYPASS=true)"
            return 0
        fi
        sleep 2
    done

    echo "==> ERROR: App failed to start within 60 seconds."
    docker logs "${CONTAINER_NAME}" 2>&1 | tail -20
    return 1
}

run_seed_python() {
    local mode="$1"
    SIYUAN_BASE_URL="http://localhost:${PORT}" SIYUAN_AUTH_CODE="${AUTH_CODE}" SIYUAN_MODE="${mode}" python3 <<'PY'
import http.cookiejar
import json
import os
import sys
import time
import urllib.error
import urllib.parse
import urllib.request

BASE_URL = os.environ["SIYUAN_BASE_URL"].rstrip("/")
AUTH_CODE = os.environ["SIYUAN_AUTH_CODE"]
MODE = os.environ["SIYUAN_MODE"]
SEED_NOTEBOOK = "Acme Launch Knowledge Base"
ASSET_PATH = "/data/assets/acme-q2-launch-brief.txt"
ASSET_TEXT = "Acme Mobile Launch Brief\nOwner: Maya Chen\nFreeze date: 2024-05-15\n"
IMAGE_ASSET_PATH = "/data/assets/acme-launch-beacon-map.svg"
IMAGE_ASSET_TEXT = """<svg xmlns="http://www.w3.org/2000/svg" width="120" height="80" viewBox="0 0 120 80">
  <rect width="120" height="80" fill="#e7f0ff"/>
  <circle cx="60" cy="40" r="18" fill="#2f6feb"/>
  <text x="60" y="45" text-anchor="middle" font-family="Arial" font-size="12" fill="white">Beacon</text>
</svg>
"""

DOCS = [
    ("/00 Inbox/Field Research - Metro Retail Visits", """# Field Research - Metro Retail Visits

Tags: #research #retail #launch-2024

Visited pilot stores on 2024-03-12 and 2024-03-13. The most repeated phrase was **checkout beacon friction**.

- Owner: Priya Nair
- Status: Synthesized
- Linked decision: ((Market Launch Decision Log))
"""),
    ("/01 Projects/Mobile Launch Plan", """# Mobile Launch Plan

Tags: #project #launch-2024 #mobile

Launch date: 2024-06-18. Release manager: Mateo Rossi.

## Milestones

- 2024-04-05: Beta cohort invited
- 2024-05-15: Localization freeze
- 2024-06-03: App store submission

Reference attachment: [Q2 launch brief](assets/acme-q2-launch-brief.txt)
Related notes: ((Weekly Review - 2024-04-19)) and ((Support Escalation Playbook))
"""),
    ("/01 Projects/Market Launch Decision Log", """# Market Launch Decision Log

Tags: #decision #launch-2024

| Date | Decision | Owner | Status |
| --- | --- | --- | --- |
| 2024-03-21 | Keep free trial at 14 days | Linh Tran | Approved |
| 2024-04-04 | Delay German paid ads | Sofia Iversen | Deferred |
| 2024-04-18 | Ship onboarding checklist | Noah Patel | Approved |

Decision D-014 cites [[Mobile Launch Plan]] and the retail research note.
"""),
    ("/02 Operations/Support Escalation Playbook", """# Support Escalation Playbook

Tags: #support #operations #playbook

Use this playbook for launch-week incidents.

1. Triage severity in the #support-war-room channel.
2. Link customer reports to the **checkout beacon friction** search phrase when relevant.
3. Escalate payment failures to Rowan Kim within 30 minutes.

Service levels: P1 = 15 minutes, P2 = 2 hours, P3 = next business day.
"""),
    ("/03 Meetings/Weekly Review - 2024-04-19", """# Weekly Review - 2024-04-19

Tags: #meeting #weekly-review #launch-2024

Attendees: Maya Chen, Mateo Rossi, Priya Nair, Rowan Kim.

## Outcomes

- Mobile Launch Plan remains green.
- Support Escalation Playbook needs a payment-failure screenshot.
- Decision Log updated with onboarding checklist approval.

Next review: 2024-04-26.
"""),
    ("/04 Reference/Architecture Notes/Sync and Offline Cache", """# Sync and Offline Cache

Tags: #architecture #offline

The mobile client keeps a seven-day offline cache for launch collateral.

- Cache owner: Elena Park
- Known risk: stale price tables after region switch
- Mitigation: force refresh after locale change

Links: [[Mobile Launch Plan]] and [[Market Launch Decision Log]].
"""),
    ("/04 Reference/Launch Database Fixtures", """# Launch Database Fixtures

Tags: #database #launch-2024 #qa-fixture

This note provides deterministic table-style fixture data for database scenario setup and static seed compliance.

## Mixed-case Beacon Filter Fixture

| Signal | Owner | Notes |
| --- | --- | --- |
| Beacon | Priya Nair | Uppercase Beacon value for case-sensitive database filtering. |
| beacon | Mateo Rossi | Lowercase beacon value for case-sensitive database filtering. |

## Launch Status Options Fixture

Allowed status options: Planned, In Review, Ready, and Blocked.

| Workstream | Status |
| --- | --- |
