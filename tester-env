## Image Asset Field Fixture

Launch image attachment for database asset-field checks: ![Acme launch beacon map](assets/acme-launch-beacon-map.svg)
"""),
]
EXPECTED_DOC_PATHS = sorted({p for path, _ in DOCS for p in ["/" + "/".join(path.strip("/").split("/")[:i]) for i in range(1, len(path.strip("/").split("/")) + 1)]})

def request_json(path, payload=None, retry_login=True):
    data = json.dumps(payload or {}).encode("utf-8")
    req = urllib.request.Request(
        BASE_URL + path,
        data=data,
        headers={"Content-Type": "application/json"},
    )
    try:
        body = OPENER.open(req, timeout=30).read().decode("utf-8")
    except urllib.error.HTTPError as exc:
        if exc.code == 401 and retry_login:
            login()
            return request_json(path, payload, retry_login=False)
        raise
    result = json.loads(body)
    if result.get("code") != 0:
        raise RuntimeError(f"{path} failed: {result}")
    return result.get("data")

def request_raw(path, payload=None):
    data = json.dumps(payload or {}).encode("utf-8")
    req = urllib.request.Request(BASE_URL + path, data=data, headers={"Content-Type": "application/json"})
    try:
        return OPENER.open(req, timeout=30).read().decode("utf-8")
    except urllib.error.HTTPError as exc:
        if exc.code == 401:
            login()
            return OPENER.open(req, timeout=30).read().decode("utf-8")
        raise

def multipart_put_file(path, content, filename, content_type, mod_time=1713139200):
    boundary = "----tester-env-siyuan-seed"
    parts = []
    def field(name, value):
        parts.append(f"--{boundary}\r\nContent-Disposition: form-data; name=\"{name}\"\r\n\r\n{value}\r\n".encode())
    field("path", path)
    field("isDir", "false")
    field("modTime", str(mod_time))
    parts.append(f"--{boundary}\r\nContent-Disposition: form-data; name=\"file\"; filename=\"{filename}\"\r\nContent-Type: {content_type}\r\n\r\n".encode())
    parts.append(content if isinstance(content, bytes) else content.encode("utf-8"))
    parts.append(f"\r\n--{boundary}--\r\n".encode())
    req = urllib.request.Request(BASE_URL + "/api/file/putFile", data=b"".join(parts), headers={"Content-Type": f"multipart/form-data; boundary={boundary}"})
    body = OPENER.open(req, timeout=30).read().decode("utf-8")
    result = json.loads(body)
    if result.get("code") != 0:
        raise RuntimeError(f"putFile failed: {result}")

def login():
    request_json("/api/system/loginAuth", {"authCode": AUTH_CODE, "rememberMe": True}, retry_login=False)

def wait_ready():
    for _ in range(60):
        try:
            request_json("/api/system/version", {})
            return
        except Exception:
            time.sleep(1)
    raise RuntimeError("SiYuan API did not become ready")

def notebooks():
    return request_json("/api/notebook/lsNotebooks", {})["notebooks"]

def seed():
    for nb in list(notebooks()):
        if nb.get("name") == SEED_NOTEBOOK:
            request_json("/api/notebook/removeNotebook", {"notebook": nb["id"]})
    nb = request_json("/api/notebook/createNotebook", {"name": SEED_NOTEBOOK})["notebook"]
    notebook_id = nb["id"]
    request_json("/api/notebook/setNotebookConf", {"notebook": notebook_id, "conf": {"name": SEED_NOTEBOOK, "closed": False, "refCreateSavePath": "", "createDocNameTemplate": "", "dailyNoteSavePath": "/Journal/2024/04", "dailyNoteTemplatePath": ""}})
    multipart_put_file(ASSET_PATH, ASSET_TEXT, "acme-q2-launch-brief.txt", "text/plain")
    multipart_put_file(IMAGE_ASSET_PATH, IMAGE_ASSET_TEXT, "acme-launch-beacon-map.svg", "image/svg+xml")
    for path, markdown in DOCS:
        request_json("/api/filetree/createDocWithMd", {"notebook": notebook_id, "path": path, "markdown": markdown})
    request_json("/api/sqlite/flushTransaction", {})
    verify()
    print(f"Seeded {SEED_NOTEBOOK}: 1 notebook, {len(EXPECTED_DOC_PATHS)} visible documents ({len(DOCS)} authored notes), 21 tag mentions, 2 attachments")

def sql(stmt):
    return request_json("/api/query/sql", {"stmt": stmt})

def verify():
    matches = [nb for nb in notebooks() if nb.get("name") == SEED_NOTEBOOK]
    if len(matches) != 1:
        raise AssertionError(f"expected one seed notebook, found {len(matches)}")
    nbid = matches[0]["id"]
    for _ in range(20):
        docs = sql(f"SELECT hpath, content FROM blocks WHERE box='{nbid}' AND type='d' ORDER BY hpath")
        phrase = sql(f"SELECT id, content FROM blocks WHERE box='{nbid}' AND content LIKE '%checkout beacon friction%'")
        if len(docs) == len(EXPECTED_DOC_PATHS) and len(phrase) >= 2:
            break
        time.sleep(0.5)
        request_json("/api/sqlite/flushTransaction", {})
    expected_paths = EXPECTED_DOC_PATHS
    actual_paths = sorted(row["hpath"] for row in docs)
    if actual_paths != expected_paths:
        raise AssertionError(f"document paths differ: {actual_paths}")
    tags = sql(f"SELECT count(*) AS c FROM blocks WHERE box='{nbid}' AND markdown LIKE '%#launch-2024%'")
    if int(tags[0]["c"]) < 3:
        raise AssertionError("expected at least 3 #launch-2024 blocks")
    data = request_raw("/api/file/getFile", {"path": ASSET_PATH})
    if "Maya Chen" not in data:
        raise AssertionError("attachment content missing Maya Chen")
    image = request_raw("/api/file/getFile", {"path": IMAGE_ASSET_PATH})
    if not image:
        raise AssertionError("image attachment missing")
    fixture = sql(f"SELECT content, markdown FROM blocks WHERE box='{nbid}' AND hpath LIKE '/04 Reference/Launch Database Fixtures%'")
    fixture_text = "\n".join((row.get("content") or "") + "\n" + (row.get("markdown") or "") for row in fixture)
    for expected in ["Beacon", "beacon", "Planned", "In Review", "Ready", "Blocked", "acme-launch-beacon-map.svg"]:
        if expected not in fixture_text:
            raise AssertionError(f"database fixture missing {expected}")
    print("Verified seed state: notebook=Acme Launch Knowledge Base visible_docs=13 authored_notes=7 phrase=checkout beacon friction tag=#launch-2024 attachments=acme-q2-launch-brief.txt,acme-launch-beacon-map.svg database_fixture=Beacon/beacon/status-options/image")

OPENER = urllib.request.build_opener(urllib.request.HTTPCookieProcessor(http.cookiejar.CookieJar()))
wait_ready()
if MODE == "seed":
    seed()
elif MODE == "verify":
    verify()
else:
    raise SystemExit(f"unknown mode {MODE}")
PY
}

cmd_seed() {
    echo "==> Seeding deterministic SiYuan knowledge base data..."
    run_seed_python seed
}

cmd_verify() {
    echo "==> Verifying deterministic SiYuan seed data..."
    run_seed_python verify
}

cmd_reset() {
    echo "==> Resetting environment..."
    docker stop "${CONTAINER_NAME}" 2>/dev/null || true
    docker rm "${CONTAINER_NAME}" 2>/dev/null || true
    docker volume rm "${DATA_VOLUME}" 2>/dev/null || true
    echo "==> Reset complete. Run 'deploy' to start fresh."
}

cmd_stop() {
    echo "==> Stopping container..."
    docker stop "${CONTAINER_NAME}" 2>/dev/null || true
    echo "==> Stopped."
}

cmd_logs() {
    docker logs -f "${CONTAINER_NAME}" 2>/dev/null || echo "Container not running."
}

cmd_status() {
    if docker ps --filter "name=${CONTAINER_NAME}" --format "{{.Names}}" | grep -q "${CONTAINER_NAME}"; then
        echo "Status: RUNNING"
        echo "URL: http://localhost:${PORT}"
        echo "Container: ${CONTAINER_NAME}"
        echo "Volume: ${DATA_VOLUME}"
    else
        echo "Status: NOT RUNNING"
    fi
}

cmd_help() {
    cat <<EOF
SiYuan - Tester Environment CLI

Usage: ./tester-env <command> [--run-id <id>] [--port <port>]

Commands:
  deploy    Build image from source, start container
  seed      Create deterministic knowledge-base seed data
  verify    Check seeded notebook, documents, tags, and attachment
  reset     Stop container, remove container and data volume
  stop      Stop container (preserves data)
  logs      Tail container logs
  status    Show container status
  help      Show this help message

Options:
  --run-id <id>     Isolate container, and volume names for parallel runs.
                    Default: default
  --port <port>     Host port to bind to container port 6806.
                    Default: 6806

Env vars:
  IMAGE_TAG         Docker image tag (default: tester-env-siyuan:dev).
                    Set by scripts/rl-env for content-addressed runs.

Typical workflow:
  ./tester-env deploy              # Build and start
  ./tester-env seed                # Populate deterministic demo data
  ./tester-env verify              # Check seeded data
  ./tester-env status              # Check status
  ./tester-env logs                # View logs
  ./tester-env reset               # Clean slate

Auth: Seed/verify use access auth code ${AUTH_CODE} when needed; deploy bypasses auth by default (SIYUAN_ACCESS_AUTH_CODE_BYPASS=true).
  To use auth, replace the env var with --accessAuthCode=<code> in the
  Docker run command in cmd_deploy().

Workspace: All data is in /siyuan/workspace (mounted as a Docker volume).
  Reset removes the volume for a clean slate.
EOF
}

main() {
    local cmd="${1:-help}"

    # Parse optional arguments
    for ((i=2; i<=$#; i++)); do
        local arg="${!i}"
        case "${arg}" in
            --run-id)
                local next=$((i+1))
                if [[ ${next} -le $# ]]; then
                    RUN_ID="${!next}"
                    ((i++))
                else
                    echo "Error: --run-id requires a value"
                    exit 1
                fi
                ;;
            --port)
                local next=$((i+1))
                if [[ ${next} -le $# ]]; then
                    PORT="${!next}"
                    ((i++))
                else
                    echo "Error: --port requires a value"
                    exit 1
                fi
                ;;
            --help|-h)
                cmd_help
                exit 0
                ;;
            *)
                echo "Unknown option: ${arg}"
                cmd_help
                exit 1
                ;;
        esac
    done

    refresh_names

	case "${cmd}" in
		deploy) cmd_deploy ;;
		seed) cmd_seed ;;
		verify) cmd_verify ;;
		reset) cmd_reset ;;
        stop) cmd_stop ;;
        logs) cmd_logs ;;
        status) cmd_status ;;
        help|--help|-h) cmd_help ;;
        *)
            echo "Unknown command: ${cmd}"
            cmd_help
            exit 1
            ;;
    esac
}

main "$@"
